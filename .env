# Database Configuration (Supports SQLite for local dev & PostgreSQL)
DATABASE_URL=sqlite:///./resqai.db

# JWT Security
SECRET_KEY=resqai_secret_key_super_secure_32_bytes_long_string_2026
REFRESH_SECRET_KEY=resqai_refresh_secret_key_super_secure_32_bytes_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload Paths
UPLOAD_DIR=backend/static/uploads

# App Settings
APP_NAME=ResQAI
ENVIRONMENT=development
API_PREFIX=/api/v1
WS_PREFIX=/ws
