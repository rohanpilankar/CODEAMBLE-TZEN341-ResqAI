   "metadata": {},
   "source": [
    "# ResqAI — XGBoost Model Testing & Prediction Pipeline\n",
    "This notebook tests the trained XGBoost model (`models/trained_models/xgb_model.pkl`) on test split data and custom disaster scenarios."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4ceffccd-d0af-498e-aaea-88fadd90fc2d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import joblib\n",
    "import json\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ad1d2954-c312-4ba4-b193-c87146a0d92f",
   "metadata": {},
   "outputs": [],
   "source": [
    "BASE_DIR = Path.cwd()\n",
    "MODELS_DIR = BASE_DIR / \"models\"\n",
    "TRAINED_MODELS_DIR = MODELS_DIR / \"trained_models\"\n",
    "LABEL_ENCODERS_DIR = MODELS_DIR / \"label_encoders\"\n",
    "SCALERS_DIR = MODELS_DIR / \"scalers\"\n",
    "DATA_DIR = BASE_DIR / \"data\" / \"processed\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c5050bd6-fdcc-4770-89ce-b9bd993d22a8",
   "metadata": {},
   "outputs": [],
   "source": [
    "xgb_model = joblib.load(TRAINED_MODELS_DIR / \"xgb_model.pkl\")\n",
    "scaler = joblib.load(SCALERS_DIR / "scaler.pkl")\n",
    "label_encoder = joblib.load(LABEL_ENCODERS_DIR / "label_encoder.pkl")\n",
    "with open(MODELS_DIR / \"feature_columns.json\", \"r\") as f:\n",
    "    feature_columns = json.load(f)\n",
    "\n",
    "print(\"Model loaded successfully!\")\n",
    "print(\"Classes:\", list(label_encoder.classes_))\n",
    "print(\"Number of features:\", len(feature_columns))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "12e11abb-fba7-4265-99d2-21dd7e30addb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load test dataset and evaluate predictions\n",
    "df = pd.read_csv(DATA_DIR / \"emdat_ai_dataset.csv\")\n",
    "TARGET = \"severity_level\"\n",
    "LEAK_COLS = [\"impact_score\", \"Total Deaths\", \"No. Injured\", \"No. Affected\", \"No. Homeless\", \"Total Affected\", \"Total Damage ('000 US$)\"]\n",
    "ADMIN_COLS = [\"DisNo.\", \"Start Date\", \"End Date\", \"Location\", \"Admin Units\"]\n",
    "ZERO_VAR_COLS = [\"Disaster Group\", \"Country\"]\n",
    "\n",
    "drop_all = [c for c in [TARGET] + LEAK_COLS + ADMIN_COLS + ZERO_VAR_COLS if c in df.columns]\n",
    "X_raw = df.drop(columns=drop_all).copy()\n",
    "y_raw = df[TARGET].copy()\n",
    "\n",
    "for col in X_raw.select_dtypes(include=[np.number]).columns:\n",
    "    X_raw[col] = X_raw[col].fillna(X_raw[col].median())\n",
    "for col in X_raw.select_dtypes(include=[\"object\"]).columns:\n",
    "    X_raw[col] = X_raw[col].fillna(\"Unknown\")\n",
    "\n",
    "X_encoded = pd.get_dummies(X_raw).reindex(columns=feature_columns, fill_value=0)\n",
    "y_encoded = label_encoder.transform(y_raw)\n",
    "\n",
    "_, X_test, _, y_test = train_test_split(X_encoded, y_encoded, test_size=0.20, random_state=42, stratify=y_encoded)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "y_pred = xgb_model.predict(X_test_scaled)\n",
    "print(\"Accuracy Score:\", accuracy_score(y_test, y_pred))\n",
    "print(\"\\nClassification Report:\")\n",
    "print(classification_report(y_test, y_pred, target_names=label_encoder.classes_))"
   ]
  }
 ],
